+bool wave_dumper_flush(wave_dumper_t *wd)
+{
+   const uint64_t now = model_now(wd->model, NULL);
+   // A zero-time design needs two entries before FST accepts a flush.
+   fstWriterEmitTimeChange(wd->fst_ctx, now);
+   fstWriterEmitTimeChange(wd->fst_ctx, now);
+   fstWriterFlushContext(wd->fst_ctx);
+   fstWriterEmitTimeChange(wd->fst_ctx, now);
+
+   if (wd->vcdfile != NULL) {
+      void *reader = fstReaderOpen(wd->tmpfst);
+      if (reader == NULL)
+         return false;
+      rewind(wd->vcdfile);
+      if (ftruncate(fileno(wd->vcdfile), 0) != 0)
+         fatal_errno("truncate live VCD");
+      fstReaderSetVcdExtensions(reader, 1);
+      const bool ok = fstReaderProcessHier(reader, wd->vcdfile);
+      fstReaderSetFacProcessMaskAll(reader);
+      fstReaderIterBlocks(reader, NULL, NULL, wd->vcdfile);
+      if (now == 0)
+         fputs("$end\n", wd->vcdfile);
+      fstReaderClose(reader);
+      fflush(wd->vcdfile);
+      return ok;
+   }
+   return true;
+}
+
+void wave_dumper_set_live(wave_dumper_t *wd)
+{
+   wd->live = true;
+}
