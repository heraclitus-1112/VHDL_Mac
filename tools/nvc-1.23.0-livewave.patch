+static int shell_cmd_simstatus(ClientData cd, Tcl_Interp *interp,
+                               int objc, Tcl_Obj *const objv[])
+{
+   tcl_shell_t *sh = cd;
+   if (!shell_has_model(sh))
+      return TCL_ERROR;
+   if (objc != 1)
+      return tcl_error(sh, "usage: simstatus");
+   Tcl_Obj *result = Tcl_NewDictObj();
+   Tcl_DictObjPut(interp, result, Tcl_NewStringObj("stopped", -1),
+                  Tcl_NewBooleanObj(model_stopped(sh->model)));
+   Tcl_DictObjPut(interp, result, Tcl_NewStringObj("pending", -1),
+                  Tcl_NewBooleanObj(model_has_pending_events(sh->model)));
+   Tcl_DictObjPut(interp, result, Tcl_NewStringObj("exitStatus", -1),
+                  Tcl_NewIntObj(model_exit_status(sh->model)));
+   Tcl_DictObjPut(interp, result, Tcl_NewStringObj("nextTime", -1),
+                  Tcl_NewWideIntObj(model_next_time(sh->model)));
+   Tcl_SetObjResult(interp, result);
+   return TCL_OK;
+}
+
+static int shell_cmd_wave(ClientData cd, Tcl_Interp *interp,
+                          int objc, Tcl_Obj *const objv[])
+{
+   tcl_shell_t *sh = cd;
+   if (!shell_has_model(sh))
+      return TCL_ERROR;
+   if (objc != 2)
+      return tcl_error(sh, "usage: wave <VCD file> | wave -flush");
+   const char *file = Tcl_GetString(objv[1]);
+   if (strcmp(file, "-flush") == 0) {
+      if (sh->wave == NULL)
+         return tcl_error(sh, "waveform dumping is not enabled");
+      return wave_dumper_flush(sh->wave) ? TCL_OK
+         : tcl_error(sh, "waveform snapshot failed");
+   }
+   if (sh->wave != NULL)
+      return tcl_error(sh, "waveform dumping is already enabled");
+   if (model_now(sh->model, NULL) != 0)
+      return tcl_error(sh, "enable wave before the first run");
+   sh->wave = wave_dumper_new(file, NULL, sh->top, WAVE_FORMAT_VCD);
+   wave_dumper_set_live(sh->wave);
+   wave_dumper_restart(sh->wave, sh->model, sh->jit);
+   return wave_dumper_flush(sh->wave) ? TCL_OK
+      : tcl_error(sh, "initial waveform snapshot failed");
 }
 
