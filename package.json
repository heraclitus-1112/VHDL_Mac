{
  "name": "nvc-runner",
  "displayName": "NVC Runner \u00b7 VHDL Simulation",
  "description": "One-click NVC simulation, input stimulus generation, persistent Surfer waveform views, and interactive sessions.",
  "version": "0.5.1",
  "publisher": "local-vhdl",
  "repository": {
    "type": "git",
    "url": "https://github.com/heraclitus-1112/VHDL_Mac.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:vhdl"
  ],
  "extensionDependencies": [
    "surfer-project.surfer"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "NVC needs to save project files and run local processes. Trust the workspace first."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "NVC requires local file paths."
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "vhdl",
        "aliases": [
          "VHDL",
          "vhdl"
        ],
        "extensions": [
          ".vhd",
          ".vhdl"
        ]
      }
    ],
    "commands": [
      {
        "command": "nvcRunner.configure",
        "title": "NVC: Configure VHDL Simulation",
        "icon": "$(gear)"
      },
      {
        "command": "nvcRunner.run",
        "title": "NVC: Run VHDL Simulation",
        "icon": "$(play)"
      },
      {
        "command": "nvcRunner.runAll",
        "title": "NVC: Run All",
        "icon": "$(play)"
      },
      {
        "command": "nvcRunner.cancel",
        "title": "NVC: Cancel VHDL Simulation",
        "icon": "$(debug-stop)"
      },
      {
        "command": "nvcRunner.generateTestbench",
        "title": "NVC: Generate Testbench",
        "icon": "$(new-file)"
      },
      {
        "command": "nvcRunner.startInteractive",
        "title": "NVC: Start Interactive Simulation"
      },
      {
        "command": "nvcRunner.stepInteractive",
        "title": "NVC: Run Simulation Segment"
      },
      {
        "command": "nvcRunner.continueInteractive",
        "title": "NVC: Continue Interactive Simulation"
      },
      {
        "command": "nvcRunner.pauseInteractive",
        "title": "NVC: Pause Interactive Simulation"
      },
      {
        "command": "nvcRunner.forceSignal",
        "title": "NVC: Force Interactive Signal"
      },
      {
        "command": "nvcRunner.releaseSignal",
        "title": "NVC: Release Signal Force"
      },
      {
        "command": "nvcRunner.examineSignal",
        "title": "NVC: Read Interactive Signal"
      },
      {
        "command": "nvcRunner.stopInteractive",
        "title": "NVC: End Interactive Simulation"
      },
      {
        "command": "nvcRunner.selectArchitecture",
        "title": "NVC: Select Testbench Architecture"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "nvcRunner.run",
          "when": "resourceExtname == .vhd || resourceExtname == .vhdl",
          "group": "navigation"
        },
        {
          "command": "nvcRunner.runAll",
          "when": "resourceExtname == .vhd || resourceExtname == .vhdl",
          "group": "nvcRunner@1"
        },
        {
          "command": "nvcRunner.selectArchitecture",
          "when": "resourceExtname == .vhd || resourceExtname == .vhdl",
          "group": "nvcRunner@2"
        }
      ],
      "explorer/context": [
        {
          "command": "nvcRunner.generateTestbench",
          "when": "resourceExtname == .vhd || resourceExtname == .vhdl",
          "group": "navigation"
        },
        {
          "command": "nvcRunner.runAll",
          "when": "resourceExtname == .vhd || resourceExtname == .vhdl",
          "group": "nvcRunner@1"
        },
        {
          "command": "nvcRunner.selectArchitecture",
          "when": "resourceExtname == .vhd || resourceExtname == .vhdl",
          "group": "nvcRunner@2"
        }
      ]
    },
    "configuration": {
      "title": "NVC Runner",
      "properties": {
        "nvcRunner.nvcPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Full path to the NVC executable. Leave empty to search PATH, /opt/homebrew/bin/nvc, and /usr/local/bin/nvc.",
          "restricted": true
        },
        "nvcRunner.waveformWindow": {
          "type": "string",
          "enum": [
            "newWindow",
            "beside"
          ],
          "enumDescriptions": [
            "Show Surfer waveforms in a separate VS Code editor window.",
            "Show code and waveforms side by side in the current window."
          ],
          "default": "newWindow",
          "description": "Default waveform display location after a successful simulation."
        },
        "nvcRunner.preserveWaveformLayout": {
          "type": "boolean",
          "default": true,
          "description": "Preserve selected signals, their order, formats, and view when rerunning the same project. Save the layout when the viewer closes. Reset the layout when the Surfer version changes."
        },
        "nvcRunner.interactiveNvcPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "restricted": true,
          "description": "NVC with Tcl and native waveform snapshot patches. The default search path is ~/.local/share/vhdl-mac/nvc-interactive-livewave/bin/nvc. Standard Homebrew NVC is used for one-click batch simulation."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "vhdl.sim.json",
        "url": "./schemas/config.schema.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "nvcRunner.waveformViewer",
        "displayName": "NVC Project Waveform",
        "selector": [
          {
            "filenamePattern": "*.nvcwave"
          }
        ],
        "priority": "default"
      }
    ]
  }
}
