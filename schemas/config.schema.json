{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VHDL NVC 仿真配置",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sources",
    "top"
  ],
  "properties": {
    "sources": {
      "description": "工作区相对源文件，按编译顺序排列；设计依赖在前，测试平台在后。",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\.[vV][hH][dD]([lL])?$"
      }
    },
    "top": {
      "description": "顶层测试平台基本实体名称。",
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9]*(_[a-zA-Z0-9]+)*$"
    },
    "standard": {
      "type": "string",
      "enum": [
        "1993",
        "2002",
        "2008"
      ],
      "default": "2008"
    },
    "stopTime": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(fs|ps|ns|us|ms|sec)$",
      "default": "1us"
    },
    "libraryPaths": {
      "description": "已有编译库的搜索目录，可以是工作区相对路径或绝对路径。",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "dumpArrays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000,
      "default": 0,
      "description": "将最多包含该数量元素的嵌套数组写入波形；0关闭。较大的值增加内存和波形文件大小。"
    }
  }
}
